  "seo_title": "Tour cervecero | Compañía Cervecera Hércules",
  "seo_title__i18n__en": "Brewery tour | Compañía Cervecera Hércules",
  "seo_description": "Conoce la planta de producción y el cuarto de barricas de Hércules, con una pinta en mano.",
  "seo_description__i18n__en": "Tour the Hércules production plant and barrel room, pint in hand.",
  "body": [
    {
      "_uid": "hero-t3",
      "component": "hero",
      "size": "media",
      "image": {
        "id": null,
        "filename": "/fotos/fabrica.jpg",
