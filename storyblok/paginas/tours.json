        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Barra principal del Jardín Hércules (si no la encuentra, pregunte al llegar)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Favor de llegar 15 minutos antes del recorrido. Habrá una tolerancia de 5 minutos."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "type": "text",
                "text": "Importante"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "No hay reembolsos en caso de no atender a un recorrido agendado o llegar después del tiempo de tolerancia."
              }
            ]
          }
        ]
      },
      "body__i18n__en": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Main bar of the Jardín Hércules (if you can't find it, ask when you arrive)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Please arrive 15 minutes before the tour. There is a 5-minute grace period."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "type": "text",
                "text": "Important"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "No refunds for missed tours or for arriving after the grace period."
              }
            ]
          }
        ]
