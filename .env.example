# Token de vista previa: Storyblok > Settings > Access Tokens (tipo "Preview")
STORYBLOK_PREVIEW_TOKEN=

# Región del espacio: eu (por defecto), us, ca, ap
STORYBLOK_REGION=eu

# draft = muestra borradores (demo y vista previa); published = solo lo publicado
STORYBLOK_VERSION=draft

# Solo para el script de carga inicial (npm run seed), nunca en Vercel:
# Personal access token: Storyblok > My account > Personal access tokens
STORYBLOK_PERSONAL_TOKEN=
# ID del espacio: Storyblok > Settings > Space
STORYBLOK_SPACE_ID=

# Opcional para npm run seed: URL de tu proyecto en Vercel. Con ella el
# script también configura la vista previa del Editor Visual.
SITE_URL=
